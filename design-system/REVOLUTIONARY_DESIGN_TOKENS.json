    },
    
    "semantic_tokens": {
      "component_padding": {
        "xs": "2",
        "sm": "3", 
        "md": "4",
        "lg": "6",
        "xl": "8"
      },
      "component_margin": {
        "xs": "2",
        "sm": "4",
        "md": "6", 
        "lg": "8",
        "xl": "12"
      },
      "section_spacing": {
        "xs": "8",
        "sm": "12",
        "md": "16",
        "lg": "24",
        "xl": "32"
      },
      "page_margins": {
        "mobile": "4",
        "tablet": "6", 
        "desktop": "8",
        "wide": "12"
      }
    }
  },

  "elevation": {
    "philosophy": "Physics-based shadows with multiple light sources",
    
    "levels": {
      "0": {
        "name": "Flat",
        "shadow": "none",
        "usage": "Flush elements, backgrounds"
      },
      "1": {
        "name": "Subtle",
        "shadow": "0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px -1px rgba(0, 0, 0, 0.1)",
        "usage": "Cards, buttons"
      },
      "2": {
        "name": "Low",
        "shadow": "0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1)", 
        "usage": "Dropdowns, tooltips"
      },
      "3": {
        "name": "Medium",
        "shadow": "0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -4px rgba(0, 0, 0, 0.1)",
        "usage": "Modals, popovers"
      },
      "4": {
        "name": "High",
        "shadow": "0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1)",
        "usage": "Sticky elements, floating panels"
      },
      "5": {
        "name": "Maximum", 
        "shadow": "0 25px 50px -12px rgba(0, 0, 0, 0.25)",
        "usage": "Modal overlays, hero elements"
      }
    },
    
    "glow_effects": {
      "primary": "0 0 20px rgba(var(--primary-500), 0.3)",
      "success": "0 0 20px rgba(var(--green-500), 0.3)",
      "warning": "0 0 20px rgba(var(--yellow-500), 0.3)",
      "error": "0 0 20px rgba(var(--red-500), 0.3)",
      "focus": "0 0 0 3px rgba(var(--primary-500), 0.2)"
    }
  },

  "motion": {
    "philosophy": "Physics-based motion with emotional intelligence",
    
    "durations": {
      "instant": "0ms",
      "fast": "150ms", 
      "normal": "300ms",
      "slow": "500ms",
      "slower": "750ms",
      "slowest": "1000ms"
    },
    
    "easing": {
      "linear": "linear",
      "ease": "ease",
      "ease_in": "cubic-bezier(0.4, 0, 1, 1)",
      "ease_out": "cubic-bezier(0, 0, 0.2, 1)",
      "ease_in_out": "cubic-bezier(0.4, 0, 0.2, 1)",
      "bounce": "cubic-bezier(0.68, -0.55, 0.265, 1.55)",
      "elastic": "cubic-bezier(0.175, 0.885, 0.32, 1.275)",
      "back": "cubic-bezier(0.68, -0.55, 0.265, 1.55)",
      "spring": "cubic-bezier(0.175, 0.885, 0.32, 1.275)"
    },
    
    "presets": {
      "fade_in": {
        "duration": "normal",
