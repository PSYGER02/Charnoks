  "typography": {
    "philosophy": "Typographic scale based on modular scale with perfect readability",
    
    "font_families": {
      "sans": {
        "name": "Inter Variable",
        "stack": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica Neue, Arial, sans-serif",
        "features": ["Variable weights", "Optical sizing", "Contextual alternates"],
        "weights": [400, 500, 600, 700, 800, 900]
      },
      "mono": {
        "name": "JetBrains Mono",
        "stack": "JetBrains Mono, ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, Liberation Mono, Courier New, monospace",
        "features": ["Ligatures", "Programming symbols"],
        "weights": [400, 500, 600, 700]
      },
      "display": {
        "name": "Instrument Serif",
        "stack": "Instrument Serif, ui-serif, Georgia, Cambria, Times New Roman, Times, serif",
        "features": ["Display optimized", "High contrast"],
        "weights": [400, 500, 600]
      }
    },
    
    "scale": {
      "philosophy": "Perfect fourth scale (1.333) with optical adjustments",
      "base_size": "16px",
      "line_height_ratio": 1.5,
      
      "sizes": {
        "xs": {
          "size": "12px",
          "line_height": "16px",
          "letter_spacing": "0.05em",
          "usage": "Captions, metadata, fine print"
        },
        "sm": {
          "size": "14px", 
          "line_height": "20px",
          "letter_spacing": "0.025em",
          "usage": "Small text, labels, secondary content"
        },
        "base": {
          "size": "16px",
          "line_height": "24px",
          "letter_spacing": "0",
          "usage": "Body text, primary content"
        },
        "lg": {
          "size": "18px",
          "line_height": "28px", 
          "letter_spacing": "-0.025em",
          "usage": "Large body text, emphasized content"
        },
        "xl": {
          "size": "20px",
          "line_height": "28px",
          "letter_spacing": "-0.025em",
          "usage": "Subheadings, large text"
        },
        "2xl": {
          "size": "24px",
          "line_height": "32px",
          "letter_spacing": "-0.05em",
          "usage": "Section headings"
        },
        "3xl": {
          "size": "30px",
          "line_height": "36px",
          "letter_spacing": "-0.05em", 
          "usage": "Page headings"
        },
        "4xl": {
          "size": "36px",
          "line_height": "40px",
          "letter_spacing": "-0.1em",
          "usage": "Large headings, hero text"
        },
        "5xl": {
          "size": "48px",
          "line_height": "48px",
          "letter_spacing": "-0.1em",
          "usage": "Display headings"
        },
        "6xl": {
          "size": "60px",
          "line_height": "60px",
          "letter_spacing": "-0.15em",
          "usage": "Large display text"
        },
        "7xl": {
          "size": "72px",
          "line_height": "72px",
          "letter_spacing": "-0.15em",
          "usage": "Hero display text"
        },
        "8xl": {
          "size": "96px",
          "line_height": "96px",
          "letter_spacing": "-0.2em",
          "usage": "Large hero text"
        },
        "9xl": {
          "size": "128px",
          "line_height": "128px",
          "letter_spacing": "-0.2em",
          "usage": "Massive display text"
        }
      },
      
      "weights": {
        "thin": 100,
        "extralight": 200,
        "light": 300,
        "normal": 400,
        "medium": 500,
        "semibold": 600,
        "bold": 700,
        "extrabold": 800,
        "black": 900
      }
    },
    
    "semantic_styles": {
      "heading_1": {
        "size": "3xl",
        "weight": "bold",
        "line_height": "tight",
        "letter_spacing": "tight",
        "margin_bottom": "lg"
      },
      "heading_2": {
        "size": "2xl",
        "weight": "semibold", 
        "line_height": "tight",
        "letter_spacing": "tight",
        "margin_bottom": "md"
      },
      "heading_3": {
        "size": "xl",
        "weight": "semibold",
        "line_height": "snug",
        "letter_spacing": "normal",
        "margin_bottom": "sm"
      },
      "body_large": {
        "size": "lg",
        "weight": "normal",
        "line_height": "relaxed",
        "letter_spacing": "normal"
      },
      "body": {
        "size": "base",
        "weight": "normal",
        "line_height": "normal",
        "letter_spacing": "normal"
      },
      "body_small": {
        "size": "sm",
        "weight": "normal",
        "line_height": "normal",
        "letter_spacing": "wide"
      },
      "caption": {
        "size": "xs",
        "weight": "medium",
        "line_height": "tight",
        "letter_spacing": "wide",
        "text_transform": "uppercase"
      }
    }
  },

  "spacing": {
    "philosophy": "8px grid system with golden ratio and fibonacci influences",
    "base_unit": "4px",
    
    "scale": {
      "0": "0px",
      "px": "1px", 
      "0.5": "2px",
      "1": "4px",
      "1.5": "6px",
      "2": "8px",
