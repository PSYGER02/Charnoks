{
  "meta": {
    "name": "Charnoks Revolutionary Design System",
    "version": "2.0.0",
    "description": "Next-generation design tokens for world-class POS interface",
    "created": "2025-10-01",
    "philosophy": "Semantic, accessible, and emotionally intelligent design language"
  },
  
  "foundation": {
    "grid": {
      "base": "4px",
      "scale": [2, 4, 8, 12, 16, 24, 32, 48, 64, 96, 128, 192, 256],
      "philosophy": "8px grid system with fibonacci-inspired scaling"
    },
    
    "breakpoints": {
      "xs": "320px",
      "sm": "640px", 
      "md": "768px",
      "lg": "1024px",
      "xl": "1280px",
      "2xl": "1536px",
      "3xl": "1920px",
      "4k": "2560px"
    },
    
    "aspect_ratios": {
      "square": "1:1",
      "card": "3:2", 
      "video": "16:9",
      "golden": "1.618:1",
      "photo": "4:3"
    }
  },

