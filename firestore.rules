rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthed() { return request.auth != null; }
    function userRole(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role;
    }
    function isOwner() { return isAuthed() && userRole(request.auth.uid) == 'owner'; }
    function isWorker() { return isAuthed() && userRole(request.auth.uid) == 'worker'; }

    // Users: user can read/write self; owner can list
    match /users/{userId} {
      allow get, update, delete: if isAuthed() && request.auth.uid == userId;
      allow create: if isAuthed() && request.auth.uid == userId; // self-provision on signup
      allow list: if isOwner();
    }

    // Products: all authed can read; only owner can write
    match /products/{productId} {
      allow read: if isAuthed();
      allow create, update, delete: if isOwner();
    }

    // Sales: owner full; worker create and read own
    match /sales/{saleId} {
      allow get: if isOwner() || (isWorker() && resource.data.workerId == request.auth.uid);
      allow list: if isOwner();
      allow create: if isWorker() && request.resource.data.workerId == request.auth.uid;
      allow update, delete: if isOwner();
    }

    // Expenses: owner full; worker create and read own
    match /expenses/{expenseId} {
      allow get: if isOwner() || (isWorker() && resource.data.workerId == request.auth.uid);
      allow list: if isOwner();
      allow create: if isWorker() && request.resource.data.workerId == request.auth.uid;
      allow update, delete: if isOwner();
    }

    // Notes: owner only
    match /notes/{noteId} {
      allow read, write: if isOwner();
    }
  }
}