# =============================================================================
# CHARNOKS V3 - UNIFIED ENVIRONMENT CONFIGURATION
# =============================================================================
# This file consolidates all environment variables for the entire system

# =============================================================================
# CORE CONFIGURATION
# =============================================================================
NODE_ENV=development
PORT=3002

# =============================================================================
# AI SERVICES CONFIGURATION
# =============================================================================

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# MCP Server Configuration  
MCP_SERVER_URL=http://localhost:3002
VITE_MCP_SERVER_URL=http://localhost:3002
MCP_AUTH_TOKEN=
VITE_MCP_AUTH_TOKEN=

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Supabase Configuration
SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# =============================================================================
# LEGACY INTEGRATIONS
# =============================================================================

# Amazon Q Integration
Q_META_KEY=your_long_random_key_for_q_metadata_access_here

# =============================================================================
# RATE LIMITING & PERFORMANCE
# =============================================================================

# API Rate Limits
MAX_REQUESTS_PER_MINUTE=50
MAX_TOKENS_PER_MINUTE=100000
MAX_CONCURRENT_REQUESTS=10

# Retry Configuration
MAX_RETRY_ATTEMPTS=3
RETRY_BACKOFF_MS=1000
REQUEST_TIMEOUT_MS=30000

# =============================================================================
# LOGGING & MONITORING
# =============================================================================

# Logging Configuration
LOG_LEVEL=info
ENABLE_AI_AUDIT_LOGS=true
ENABLE_REQUEST_LOGGING=true
ENABLE_PERFORMANCE_MONITORING=true

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-domain.com
ENABLE_CORS=true

# API Security
API_KEY_HEADER=X-API-Key
ENABLE_RATE_LIMITING=true

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# AI Features
ENABLE_MCP_ROUTING=true
ENABLE_FALLBACK_API=true
ENABLE_SMART_MODEL_SELECTION=true
ENABLE_EMBEDDING_CACHE=true

# Business Features
ENABLE_MEMORY_SERVICE=false
ENABLE_ADVANCED_ANALYTICS=true
ENABLE_OFFLINE_SYNC=true

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================

# Health Check Configuration
HEALTH_CHECK_INTERVAL=60000
HEALTH_CHECK_TIMEOUT=5000

# Cleanup Configuration
LOG_RETENTION_DAYS=30
CACHE_CLEANUP_INTERVAL=3600000

# =============================================================================
# DEVELOPMENT/TESTING
# =============================================================================

# Test Configuration
TEST_SERVER_URL=http://localhost:3002
TEST_TIMEOUT=30000
ENABLE_TEST_MODE=false

# Development Features
ENABLE_DEBUG_MODE=false
ENABLE_MOCK_RESPONSES=false

# Optional: Production Environment
NODE_ENV=development
